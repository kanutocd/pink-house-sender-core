module Sender
  module Core
    class Error < StandardError
    end

    VERSION: String

    module Capabilities
      KNOWN: Array[Symbol]

      def self.normalize: (Array[Symbol | String] values) -> Array[Symbol]
    end

    module Errors
      FAILOVER_CATEGORIES: Array[Symbol]
      RETRYABLE_CATEGORIES: Array[Symbol]

      class Base < Error
        attr_reader category: Symbol
        attr_reader provider: Symbol?

        def initialize: (?String?, ?category: Symbol?, ?provider: Symbol?) -> void
        def retryable?: () -> bool
        def failover?: () -> bool
      end

      class ProviderError < Base
      end
      class Network < ProviderError
      end
      class Timeout < ProviderError
      end
      class RateLimited < ProviderError
      end
      class Authentication < ProviderError
      end
      class Authorization < ProviderError
      end
      class InvalidRequest < Base
      end
      class InvalidRecipient < Base
      end
      class ProviderUnavailable < ProviderError
      end
      class ProviderRejected < Base
      end
      class Unknown < Base
      end
      class ConfigurationError < Base
      end
    end

    class Message
      attr_reader to: String
      attr_reader body: String
      attr_reader metadata: Hash[untyped, untyped]
      attr_reader requirements: Array[Symbol]

      def initialize: (to: String, body: String, ?metadata: Hash[untyped, untyped], ?requirements: Array[Symbol | String]) -> void
    end

    class ProviderConfiguration
      SUPPORT_LEVELS: Array[Symbol]
      attr_reader name: Symbol
      attr_reader settings: Hash[untyped, untyped]
      attr_reader enabled: bool
      attr_reader priority: Integer
      attr_reader capabilities: Array[Symbol]
      attr_reader support_level: Symbol

      def initialize: (name: Symbol | String, ?settings: Hash[untyped, untyped], ?enabled: bool, ?priority: Integer, ?capabilities: Array[Symbol | String]) -> void
      def with_support_level: (Symbol | String value) -> ProviderConfiguration
      def []: (Symbol | String key) -> untyped
      def enabled?: () -> bool
    end

    class Provider
      attr_reader configuration: ProviderConfiguration
      def initialize: (configuration: ProviderConfiguration) -> void
      def name: () -> Symbol
      def capabilities: () -> Array[Symbol]
      def support_level: () -> Symbol
    end

    class ProviderRegistry
      def initialize: (?catalog: Hash[Symbol | String, untyped], ?default_capabilities: Array[Symbol]) -> void
      def supported: () -> Array[Symbol]
      def configured: () -> Array[Symbol]
      def provider_metadata: (Symbol | String name) -> Hash[Symbol, untyped]
      def register: (Symbol | String name, loader: ^() -> Class, ?capabilities: Array[Symbol], ?support_level: Symbol | String, ?adapter: Symbol | String?) -> Symbol
      def register_alias: (Symbol | String name, source: Symbol | String) -> Symbol
      def configure: (Symbol | String name, ?settings: Hash[untyped, untyped], ?enabled: bool, ?priority: Integer, ?capabilities: Array[Symbol]?) -> ProviderConfiguration
      def provider: (Symbol | String name) -> Provider
      def providers: () -> Array[Provider]
    end

    class Delivery
      STATUSES: Array[Symbol]
      attr_reader status: Symbol
      attr_reader provider: Symbol?
      attr_reader provider_message_id: String?
      attr_reader attempts: Array[Hash[untyped, untyped]]
      attr_reader error: Errors::Base?
      attr_reader metadata: Hash[untyped, untyped]

      def initialize: (?status: Symbol | String, ?provider: Symbol | String?, ?provider_message_id: untyped, ?attempts: Array[Hash[untyped, untyped]], ?error: Errors::Base?, ?metadata: Hash[untyped, untyped]) -> void
      def accepted?: () -> bool
      def delivered?: () -> bool
      def failed?: () -> bool
      def with_event: (DeliveryEvent event) -> Delivery
    end

    module StateStore
      module Contract
        REQUIRED_METHODS: Array[Symbol]
        KEY_REQUIREMENTS: String

        def self.validate!: (untyped store) -> untyped
        def self.validate_key!: (untyped key) -> untyped
      end

      class Memory
        def read: (untyped key) -> untyped
        def write: (untyped key, untyped value) -> untyped
        def fetch: (untyped key) { () -> untyped } -> untyped
        def update: (untyped key, ?default: untyped) { (untyped) -> untyped } -> untyped
        def delete: (untyped key) -> untyped
        def clear: () -> untyped
      end

      class Redis
        class BackendError < ::Sender::Core::Error
        end

        def initialize: (redis: untyped, ?namespace: String, ?ttl: Integer?, ?max_retries: Integer) -> void
        def read: (untyped key) -> untyped
        def write: (untyped key, untyped value) -> untyped
        def fetch: (untyped key) { () -> untyped } -> untyped
        def update: (untyped key, ?default: untyped) { (untyped) -> untyped } -> untyped
        def delete: (untyped key) -> untyped
        def clear: () -> nil
      end
    end
  end
end
